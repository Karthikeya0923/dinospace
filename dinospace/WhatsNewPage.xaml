<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.WhatsNewPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource BackdropBrush}}"
             Title="What's New">
    <Grid>
        <Image Source="mainbackground.png" Aspect="AspectFill" InputTransparent="True"/>


        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <Label Text="What's New"
                   FontSize="28"
                   FontAttributes="Bold"
                   Margin="0,8,0,0"/>

                <Label x:Name="VersionLabel"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                <!-- Add a new Frame here before each Google Play update -->
                <!-- Copy the format below and fill in what changed -->

                <Frame Padding="16" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Version 1.0" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Initial release of DinoSpace." FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" LineHeight="1.5"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>