<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.ExplorePage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource BackdropBrush}}"
             Title="Explore">
    <Grid>
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeLeft"/>
            <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeRight"/>
        </Grid.GestureRecognizers>

        <Image Source="mainbackground.png" Aspect="AspectFill" InputTransparent="True"/>


        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Explore" FontSize="26" FontAttributes="Bold" FontFamily="Baloo"/>
                    <Label Text="Discover amazing things" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </VerticalStackLayout>

                <!-- Did You Know -->
                <Frame Padding="16" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Did You Know?" FontSize="16" FontFamily="Baloo" FontAttributes="Bold"/>
                        <Label x:Name="DidYouKnowLabel" FontSize="14" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Label Text="Tap for another fact" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}"/>
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDidYouKnowTapped"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Featured of the Day -->
                <Frame Padding="16" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Featured of the Day" FontSize="16" FontFamily="Baloo" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Button Grid.Column="1" x:Name="FeaturedToggle" Text="Switch" FontSize="12" Padding="10,2" Clicked="OnFeaturedToggle" BackgroundColor="#E8D5B0" TextColor="#1B1000"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image x:Name="FeaturedImage" Grid.Column="0" WidthRequest="64" HeightRequest="64" Aspect="AspectFill" BackgroundColor="{AppThemeBinding Light={StaticResource ImgPlaceholderLight}, Dark={StaticResource ImgPlaceholderDark}}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="FeaturedTag" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                <Label x:Name="FeaturedName" FontSize="17" FontAttributes="Bold" FontFamily="Baloo"/>
                                <Label x:Name="FeaturedSubtitle" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeaturedTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Your Progress -->
                <Label Text="Your Progress" FontSize="20" FontFamily="Baloo" FontAttributes="Bold" Margin="0,4,0,0"/>
                <Frame Padding="16" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="ProgressDinoCount" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Dinosaurs" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="ProgressSpaceCount" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Space objects" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label x:Name="ProgressSavedCount" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Saved" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#22FFFFFF"/>

                        <Label Text="Best Quiz Scores" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="ProgressDinoBest" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                                <Label Text="Dinosaurs" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="ProgressSpaceBest" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                                <Label Text="Space" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label x:Name="ProgressMixedBest" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                                <Label Text="Mixed" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Try Something Fun -->
                <Label Text="Try Something Fun" FontSize="20" FontFamily="Baloo" FontAttributes="Bold" Margin="0,4,0,0"/>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                    <Frame Grid.Column="0" Padding="10" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False" HeightRequest="100">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="Quiz" FontSize="15" FontFamily="Baloo" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Test your knowledge" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuizTapped"/>
                        </Frame.GestureRecognizers>
                    </Frame>

                    <Frame Grid.Column="1" Padding="10" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False" HeightRequest="100">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="Surprise Me" FontSize="15" FontFamily="Baloo" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label Text="A random discovery" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSurpriseTapped"/>
                        </Frame.GestureRecognizers>
                    </Frame>

                    <Frame Grid.Column="2" Padding="10" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False" HeightRequest="100">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="Compare" FontSize="15" FontFamily="Baloo" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Coming soon" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCompareTapped"/>
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <!-- Collections -->
                <Label Text="Collections" FontSize="20" FontFamily="Baloo" FontAttributes="Bold" Margin="0,4,0,0"/>
                <VerticalStackLayout x:Name="CollectionsStack" Spacing="8"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>