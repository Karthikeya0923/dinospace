<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.SavedPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource BackdropBrush}}"
             Title="Saved">
    <Grid>
        <Image Source="mainbackground.png" Aspect="AspectFill" InputTransparent="True"/>


        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="14">

            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="Saved" FontSize="26" FontAttributes="Bold" FontFamily="Baloo"/>
                <Label Text="Your saved favorites" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="FilterAll" Text="All" Clicked="OnFilterAll"/>
                    <Button x:Name="FilterDino" Text="Dinosaurs" Clicked="OnFilterDino"/>
                    <Button x:Name="FilterSpace" Text="Space" Clicked="OnFilterSpace"/>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Frame Grid.Column="0" Padding="6,0" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                    <Entry x:Name="SearchEntry"
                       Placeholder="Search to save..."
                       TextChanged="OnSearchTextChanged"
                       ClearButtonVisibility="WhileEditing"/>
                </Frame>
                <Button Grid.Column="1" Text="Save" Clicked="OnSaveClicked" BackgroundColor="#E8D5B0" TextColor="#1B1000"/>
            </Grid>

            <!-- Overlap area: saved list + tap-away layer + dropdown -->
            <Grid Grid.Row="3">

                <ScrollView>
                    <VerticalStackLayout x:Name="SavedStack" Spacing="8"/>
                </ScrollView>

                <BoxView x:Name="DismissLayer"
                     BackgroundColor="#01000000"
                     IsVisible="False">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDismissTapped"/>
                    </BoxView.GestureRecognizers>
                </BoxView>

                <!-- ScrollView removed — VerticalStackLayout sizes the Frame directly -->
                <Frame x:Name="SearchDropdown"
                   IsVisible="False"
                   VerticalOptions="Start"
                   Padding="0"
                   CornerRadius="14"
                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                   BackgroundColor="#B3000000"
                   HasShadow="True"
                   MaximumHeightRequest="320">
                    <VerticalStackLayout x:Name="DropdownStack"/>
                </Frame>

            </Grid>

        </Grid>

    </Grid>
</ContentPage>