<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.SettingsPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource BackdropBrush}}"
             Title="Settings">
    <Grid>
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeRight"/>
        </Grid.GestureRecognizers>

        <Image Source="mainbackground.png" Aspect="AspectFill" InputTransparent="True"/>


        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="0">

                <Label Text="Settings"
                   FontSize="26"
                   FontAttributes="Bold"
                   FontFamily="Baloo"
                   Margin="0,0,0,4"/>
                <Label Text="Customize your experience"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   Margin="0,0,0,20"/>

                <!-- App Settings section -->
                <Label Text="APP SETTINGS"
                   FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   Margin="4,0,0,8"/>

                <Frame Padding="0" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="0">

                        <!-- Clear Data -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Clear Data" FontSize="15" FontFamily="Baloo" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"/>
                                <Label Text="Clears all saved items and progress" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearDataTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- About section -->
                <Label Text="ABOUT"
                   FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   Margin="4,0,0,8"/>

                <Frame Padding="0" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="0">

                        <!-- What's New -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="What's New" FontSize="15" FontFamily="Baloo" FontAttributes="Bold"/>
                                <Label Text="Latest updates and changes" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWhatsNewTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#22FFFFFF" Margin="16,0"/>

                        <!-- Privacy Policy -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Privacy Policy" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="How we handle your data" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#22FFFFFF" Margin="16,0"/>

                        <!-- Credits -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Credits" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="The people behind DinoSpace" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreditsTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Contact section -->
                <Label Text="CONTACT"
                   FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   Margin="4,0,0,8"/>

                <Frame Padding="0" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="0">

                        <!-- Feedback -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Send Feedback" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="Share your thoughts or report a bug" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeedbackTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Version at bottom -->
                <Label x:Name="VersionLabel"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,24"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>