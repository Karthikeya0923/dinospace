<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.ScanSkyPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource BackdropBrush}}"
             Title="Scan Sky">
    <Grid>
        <Image Source="mainbackground.png" Aspect="AspectFill" InputTransparent="True"/>

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
        <Image Source="scanskylogo.png" HeightRequest="120" Aspect="AspectFit" HorizontalOptions="Center"/>
        <Label Text="Scan Sky" FontSize="22" FontFamily="Baloo" FontAttributes="Bold" HorizontalOptions="Center"/>
        <Label Text="Coming soon" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
    </VerticalStackLayout>
    </Grid>
</ContentPage>