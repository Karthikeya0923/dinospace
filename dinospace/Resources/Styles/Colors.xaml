<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================
         DinoSpace design tokens — warm editorial light theme.
         Mirrors Ui/Theme.cs. One accent (red), paper surfaces,
         black serif headlines.
         ============================================================ -->

    <Color x:Key="Bg">#FBF9F5</Color>
    <Color x:Key="BgRaised">#FFFFFF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#F3EFE8</Color>
    <Color x:Key="SurfaceSunken">#F3EFE8</Color>

    <Color x:Key="Hairline">#E7E0D2</Color>
    <Color x:Key="HairlineSoft">#EEE9DD</Color>

    <Color x:Key="TextPrimary">#1C1B1A</Color>
    <Color x:Key="TextSecondary">#6E6963</Color>
    <Color x:Key="TextHint">#A39D93</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <Color x:Key="Accent">#D93025</Color>
    <Color x:Key="AccentSoft">#FBE9E7</Color>

    <!-- Legacy keys used by older styles -->
    <Color x:Key="AccentDino">#D93025</Color>
    <Color x:Key="AccentDinoDim">#FBE9E7</Color>
    <Color x:Key="AccentSpace">#D93025</Color>
    <Color x:Key="AccentSpaceDim">#FBE9E7</Color>
    <Color x:Key="AccentNova">#D93025</Color>
    <Color x:Key="AccentNovaDim">#FBE9E7</Color>

    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="SuccessDim">#E5F1E6</Color>
    <Color x:Key="Danger">#C62828</Color>
    <Color x:Key="DangerDim">#FBE9E7</Color>

    <Color x:Key="ChipBg">#F3EFE8</Color>
    <Color x:Key="ChipText">#57524B</Color>
    <Color x:Key="ImgPlaceholder">#EFEAE0</Color>
    <Color x:Key="Scrim">#66000000</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />

    <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource Bg}" />

    <!-- Legacy keys kept so the default MAUI styles that reference them still resolve. -->
    <Color x:Key="Primary">#D93025</Color>
    <Color x:Key="PrimaryDark">#D93025</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#6E6963</Color>
    <Color x:Key="SecondaryDarkText">#6E6963</Color>
    <Color x:Key="Tertiary">#D93025</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

</ResourceDictionary>
