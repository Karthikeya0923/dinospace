<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.SpacePediaPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource StarsBrush}}">
    <Grid>
        <Image Source="spacebackground.png" Aspect="AspectFill" InputTransparent="True"/>

        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="14">

            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Image Source="spacepedialogo.png" HeightRequest="64" Aspect="AspectFit" HorizontalOptions="Center"/>
                <Label Text="Explore the universe" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Frame Grid.Column="0" Padding="6,0" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                    <Entry x:Name="SearchEntry" Placeholder="Search planets, stars, galaxies..." Completed="OnSearchCompleted" TextChanged="OnSearchChanged" ClearButtonVisibility="WhileEditing"/>
                </Frame>
                <Button Grid.Column="1" x:Name="FilterButton" Text="Filters" FontSize="13" Padding="14,0" Clicked="OnFilterToggle" BackgroundColor="#E8D5B0" TextColor="#1B1000"/>
            </Grid>

            <Frame Grid.Row="2" x:Name="FilterPanel" IsVisible="False" Padding="14" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                <VerticalStackLayout x:Name="FilterChips" Spacing="12"/>
            </Frame>

            <CollectionView Grid.Row="3" x:Name="ResultsList" SelectionMode="None" VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,4">
                            <Frame Padding="12" CornerRadius="14" HasShadow="False" BackgroundColor="#66000000" BorderColor="#4DFFFFFF">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Image Grid.Column="0" Source="{Binding ImageFile}" WidthRequest="56" HeightRequest="56" Aspect="AspectFill" BackgroundColor="#26FFFFFF"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" FontFamily="Baloo" TextColor="#F5F7FB" VerticalOptions="Center"/>
                                            <Frame Padding="8,3" CornerRadius="8" HasShadow="False" BackgroundColor="#33FFFFFF" BorderColor="Transparent" VerticalOptions="Center">
                                                <Label Text="{Binding TypeLabel}" FontSize="11" TextColor="#EAEDF3"/>
                                            </Frame>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding ShortDescription}" FontSize="12" TextColor="#AEB6C6"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#7E8696" VerticalOptions="Center"/>
                                </Grid>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSpaceTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Nothing matches these filters" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center" Margin="0,16"/>
                </CollectionView.EmptyView>
            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>