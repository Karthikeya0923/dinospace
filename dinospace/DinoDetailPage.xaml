<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.DinoDetailPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource StoneBrush}}">
    <Grid>
        <Image Source="dinobackground.png" Aspect="AspectFill" InputTransparent="True"/>


        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,10" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Label Grid.Column="0" Text="‹ Back" FontSize="17" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Image Grid.Column="2" x:Name="BookmarkImage" Source="bookmark.png"
                   WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBookmarkClicked"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <ScrollView Grid.Row="1" x:Name="DetailScroll" Scrolled="OnScrolled">
                <VerticalStackLayout Spacing="0">

                    <Image x:Name="HeroImage" HeightRequest="220" Aspect="AspectFill" BackgroundColor="{AppThemeBinding Light={StaticResource ImgPlaceholderLight}, Dark={StaticResource ImgPlaceholderDark}}"/>

                    <VerticalStackLayout Padding="16" Spacing="14">

                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="NameLabel" FontSize="28" FontAttributes="Bold" FontFamily="Baloo"/>
                            <Label x:Name="PronunciationLabel" FontSize="13" FontAttributes="Italic" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            <Label x:Name="MeaningLabel" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            <Label x:Name="EraLabel" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                        </VerticalStackLayout>

                        <HorizontalStackLayout x:Name="ChipRow" Spacing="8"/>

                        <Frame Padding="14" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="2">
                                    <Label x:Name="LengthHeader" Text="Length" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label x:Name="LengthLabel" FontSize="15" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="2">
                                    <Label x:Name="HeightWidthLabel" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label x:Name="HeightWidthValue" FontSize="15" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="2">
                                    <Label Text="Weight" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label x:Name="WeightLabel" FontSize="15" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="2">
                                    <Label Text="Speed" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label x:Name="SpeedLabel" FontSize="15" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>

                        <Frame Padding="14" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="About" FontSize="16" FontFamily="Baloo" FontAttributes="Bold"/>
                                <Label x:Name="AboutLabel" FontSize="14" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Padding="14" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Key Features" FontSize="16" FontFamily="Baloo" FontAttributes="Bold"/>
                                <Label x:Name="KeyFeaturesLabel" FontSize="14" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Padding="14" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Life &amp; Environment" FontSize="16" FontFamily="Baloo" FontAttributes="Bold"/>
                                <Label x:Name="LifeEnvironmentLabel" FontSize="14" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Padding="14" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Behaviour" FontSize="16" FontFamily="Baloo" FontAttributes="Bold"/>
                                <Label x:Name="BehaviourLabel" FontSize="14" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Padding="14" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False" Margin="0,0,0,24">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Fun Facts" FontSize="16" FontFamily="Baloo" FontAttributes="Bold"/>
                                <Label x:Name="FunFactsLabel" FontSize="14" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="1"
                x:Name="BackToTopButton"
                Text="↑ Top"
                IsVisible="False"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,16,20"
                Padding="14,8"
                CornerRadius="20"
                FontSize="13"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                TextColor="White"
                Clicked="OnBackToTopClicked"/>

        </Grid>

    </Grid>
</ContentPage>
