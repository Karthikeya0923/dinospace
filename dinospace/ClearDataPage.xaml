<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.ClearDataPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource BackdropBrush}}"
             Title="Clear Data">
    <Grid>
        <Image Source="mainbackground.png" Aspect="AspectFill" InputTransparent="True"/>


        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12,10" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Label Grid.Column="0" Text="‹ Back" FontSize="17" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16" Spacing="16">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Clear Data" FontSize="26" FontFamily="Baloo" FontAttributes="Bold"/>
                        <Label Text="Choose what to reset. This can't be undone." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    </VerticalStackLayout>

                    <!-- Select All -->
                    <Frame Padding="14,12" CornerRadius="14" BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" x:Name="SelectAllLabel" Text="Select All"
                               FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}" VerticalOptions="Center"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectAllTapped"/>
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Checklist (built in code) -->
                    <VerticalStackLayout x:Name="ItemsStack" Spacing="10"/>

                    <Label Text="Note: your dinosaur and space entries are part of the app itself, so they can't be cleared here."
                       FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextHintLight}, Dark={StaticResource TextHintDark}}"/>

                    <Button Text="Clear Selected Data" BackgroundColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" TextColor="White"
                        Clicked="OnClearSelectedClicked" Margin="0,4,0,0"/>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>
</ContentPage>