<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dinospace.QuizPage"
             Background="{AppThemeBinding Light={StaticResource PageBgBrushLight}, Dark={StaticResource BackdropBrush}}"
             Title="Quiz">
    <Grid>
        <Image Source="mainbackground.png" Aspect="AspectFill" InputTransparent="True"/>


        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12,10" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Label Grid.Column="0" Text="‹ Back" FontSize="17" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBack"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16" Spacing="16">

                    <!-- Quiz -->
                    <VerticalStackLayout x:Name="QuizPanel" Spacing="14">

                        <ProgressBar x:Name="QuizProgress" Progress="0" ProgressColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" HeightRequest="6"/>
                        <Label x:Name="ProgressLabel" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                        <Label x:Name="QuestionLabel" FontSize="20" FontAttributes="Bold" Margin="0,4,0,4"/>

                        <Frame x:Name="Opt0" Padding="14" CornerRadius="12" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource ChipBgLight}, Dark={StaticResource ChipBgDark}}" HasShadow="False">
                            <Label x:Name="Opt0Label" FontSize="16"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpt0"/>
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Frame x:Name="Opt1" Padding="14" CornerRadius="12" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource ChipBgLight}, Dark={StaticResource ChipBgDark}}" HasShadow="False">
                            <Label x:Name="Opt1Label" FontSize="16"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpt1"/>
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Frame x:Name="Opt2" Padding="14" CornerRadius="12" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource ChipBgLight}, Dark={StaticResource ChipBgDark}}" HasShadow="False">
                            <Label x:Name="Opt2Label" FontSize="16"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpt2"/>
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Frame x:Name="Opt3" Padding="14" CornerRadius="12" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource ChipBgLight}, Dark={StaticResource ChipBgDark}}" HasShadow="False">
                            <Label x:Name="Opt3Label" FontSize="16"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpt3"/>
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Button x:Name="NextButton" Text="Next" Clicked="OnNext" IsVisible="False" Margin="0,6,0,0"/>

                    </VerticalStackLayout>

                    <!-- Results -->
                    <VerticalStackLayout x:Name="ResultsPanel" Spacing="14" IsVisible="False" Margin="0,30,0,0">
                        <Label x:Name="ScoreLabel" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Label x:Name="BestLabel" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="Center"/>
                        <Button Text="Play Again" Clicked="OnPlayAgain" Margin="0,10,0,0"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>
</ContentPage>