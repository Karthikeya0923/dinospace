<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:dinospace"
             x:Class="dinospace.AskAiPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" Padding="6,12,12,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
            <Button Grid.Column="0" Text="←" FontSize="22" Clicked="OnBackClicked"
                    BackgroundColor="Transparent" TextColor="{x:Static local:Theme.TextPrimary}"
                    Padding="10,0" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="NovaSaur" FontSize="20" FontAttributes="Bold"
                       TextColor="{x:Static local:Theme.TextPrimary}" />
                <Label Text="Dinosaur and space helper" FontSize="11"
                       TextColor="{x:Static local:Theme.TextSecondary}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Clear" Clicked="OnClearClicked" FontSize="13"
                    BackgroundColor="Transparent" TextColor="{x:Static local:Theme.TextSecondary}"
                    Padding="10,0" VerticalOptions="Center" />
        </Grid>

        <BoxView Grid.Row="1" HeightRequest="1" Color="{x:Static local:Theme.Border}" />

        <ScrollView Grid.Row="2" x:Name="ChatScroll" Padding="16,12">
            <VerticalStackLayout x:Name="ChatStack" Spacing="10" />
        </ScrollView>

        <Grid Grid.Row="2" x:Name="DownloadOverlay" IsVisible="False" Padding="28">
            <VerticalStackLayout VerticalOptions="Center" Spacing="16">
                <Label Text="Meet NovaSaur" FontSize="24" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="{x:Static local:Theme.TextPrimary}" />
                <Label x:Name="DownloadIntroLabel"
                       Text="An offline AI that answers your dinosaur and space questions, right on your phone. It needs a one-time download of about 3 GB, so use wifi if you can."
                       FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{x:Static local:Theme.TextSecondary}" />
                <Button x:Name="DownloadButton" Text="Download NovaSaur" Clicked="OnDownloadClicked"
                        BackgroundColor="#512BD4" TextColor="White" CornerRadius="24" HeightRequest="50" />
                <VerticalStackLayout x:Name="DownloadProgressArea" IsVisible="False" Spacing="10">
                    <ProgressBar x:Name="DownloadProgress" Progress="0" ProgressColor="#512BD4" />
                    <Label x:Name="DownloadStatus" Text="Downloading NovaSaur... 0%"
                           FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{x:Static local:Theme.TextPrimary}" />
                    <Grid x:Name="DownloadButtonsRow" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" x:Name="PauseResumeButton" Text="Pause" Clicked="OnPauseResumeClicked"
                                BackgroundColor="{x:Static local:Theme.Surface}" TextColor="{x:Static local:Theme.TextPrimary}"
                                BorderColor="{x:Static local:Theme.Border}" BorderWidth="1" CornerRadius="22" HeightRequest="46" />
                        <Button Grid.Column="1" x:Name="StopButton" Text="Stop" Clicked="OnStopClicked"
                                BackgroundColor="{x:Static local:Theme.Surface}" TextColor="#C0392B"
                                BorderColor="{x:Static local:Theme.Border}" BorderWidth="1" CornerRadius="22" HeightRequest="46" />
                    </Grid>
                    <Label x:Name="DownloadFooterLabel"
                           Text="Feel free to leave and keep using the app. The download keeps going in the background, even if you close DinoSpace."
                           FontSize="13" HorizontalTextAlignment="Center"
                           TextColor="{x:Static local:Theme.TextSecondary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="3" x:Name="InputArea" Spacing="8" Padding="12,8,12,12">
            <Label Text="NovaSaur can make mistakes. Answers are made on your device."
                   FontSize="10.5" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   TextColor="{x:Static local:Theme.TextSecondary}" />
            <ScrollView x:Name="SuggestionScroll" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="SuggestionStack" Spacing="8" />
            </ScrollView>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 22" StrokeThickness="1"
                        Stroke="{x:Static local:Theme.Border}" BackgroundColor="{x:Static local:Theme.Surface}"
                        Padding="10,2" VerticalOptions="End">
                    <Editor x:Name="QuestionEntry" Placeholder="Ask about dinosaurs or space..."
                            PlaceholderColor="{x:Static local:Theme.TextSecondary}"
                            AutoSize="TextChanges" MaximumHeightRequest="120"
                            BackgroundColor="Transparent" FontSize="15"
                            TextColor="{x:Static local:Theme.TextPrimary}" />
                </Border>
                <Button Grid.Column="1" x:Name="SendButton" Text="Send" Clicked="OnSendClicked"
                        BackgroundColor="#512BD4" TextColor="White"
                        CornerRadius="22" Padding="18,0" HeightRequest="46" VerticalOptions="End" />
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
