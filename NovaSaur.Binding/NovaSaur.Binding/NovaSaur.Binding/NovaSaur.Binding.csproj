<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsTrimmable>true</IsTrimmable>
		<!-- Always emit portable debug symbols so the app can be launched WITH
		     the debugger (F5), not only "Start Without Debugging". -->
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<!-- This binding ships no Android resources; skip the resource designer
		     so its design-time build doesn't look for a missing Designer.dll. -->
		<AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
		<AndroidUseDesignerAssembly>false</AndroidUseDesignerAssembly>
	</PropertyGroup>

	<ItemGroup>
		<!-- Your NovaSaur library. The .aar is auto-picked-up from this folder;
         Update (not Include) sets Bind without creating a duplicate item. -->
		<AndroidLibrary Update="novasaur.aar" Bind="true" />

		<!-- LiteRT-LM: pulled from Maven, packaged but NOT bound. Use the REAL version number. -->
		<AndroidMavenLibrary Include="com.google.ai.edge.litertlm:litertlm-android" Version="0.13.1" Bind="false" Repository="Google" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="GoogleGson" Version="2.14.0" />
	  <PackageReference Include="Xamarin.Kotlin.Reflect" Version="2.4.0" />
	  <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.11.0" />
	</ItemGroup>
</Project>